# Run npm run convex:dev to generate your deployment settings in .env.local.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Server-side only; works with the College Basketball Data TypeScript SDK.
CFBD_API_KEY=

# Server-side read-only Kalshi credentials. Private key may be a file path or PEM.
KALSHI_API_ID=
KALSHI_PRIVATE_KEY=
